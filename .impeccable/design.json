      "html": "<button class=\"ds-button ds-button-danger\" type=\"button\">Resign</button>",
      "css": ".ds-button{display:inline-flex;align-items:center;justify-content:center;gap:.65rem;min-height:48px;padding:.7rem 1.25rem;border:1px solid transparent;border-radius:var(--radius,.75rem);font-family:\"Readex Pro\",system-ui,sans-serif;font-weight:500;font-size:.875rem;line-height:1.5;text-align:center;cursor:pointer;transition:transform 180ms var(--ease,cubic-bezier(.16,1,.3,1)),background-color 180ms,border-color 180ms}.ds-button:hover:not(:disabled){transform:translateY(-2px)}.ds-button:active:not(:disabled){transform:translateY(0) scale(.98)}.ds-button:focus-visible{outline:3px solid var(--accent,#74293f);outline-offset:4px}.ds-button:disabled{cursor:wait;opacity:.6}@media(prefers-reduced-motion:reduce){.ds-button{transition:none}}.ds-button-danger{background:var(--error,#ae263f);color:var(--on-error,#fff);border-color:transparent}"
    },
    {
      "name": "Text Field",
      "kind": "input",
      "refersTo": "text-field",
      "description": "A labelled native input with linked hint text.",
      "html": "<div class=\"ds-field\"><label for=\"ds-room-code\">Room code</label><input id=\"ds-room-code\" type=\"text\" dir=\"ltr\" placeholder=\"Enter room code\" aria-describedby=\"ds-room-hint\"><small id=\"ds-room-hint\">Ask your friend for the room code.</small></div>",
      "css": ".ds-field{display:flex;flex-direction:column;gap:.45rem;font-family:\"Readex Pro\",system-ui,sans-serif;color:var(--text,#35242d)}.ds-field label{font-size:.8125rem;font-weight:500}.ds-field input{background:var(--surface,#fffafb);border:1px solid var(--control-border,#957483);border-radius:var(--radius,.75rem);color:var(--text,#35242d);min-height:48px;padding:.75rem .875rem;font:inherit;transition:border-color 150ms,background-color 150ms}.ds-field input:hover{border-color:var(--accent,#74293f)}.ds-field input:focus-visible{outline:3px solid var(--accent,#74293f);outline-offset:4px}.ds-field input[aria-invalid=\"true\"]{border-color:var(--error,#ae263f)}.ds-field input:read-only{background:var(--muted-surface,#efe4e8)}.ds-field input::placeholder,.ds-field small{color:var(--muted,#705963)}.ds-field small{font-size:.8125rem}@media(prefers-reduced-motion:reduce){.ds-field input{transition:none}}"
