      "css": ".ds-button{display:inline-flex;align-items:center;justify-content:center;gap:.65rem;min-height:48px;padding:.7rem 1.25rem;border:1px solid transparent;border-radius:var(--radius,.75rem);font-family:\"Readex Pro\",system-ui,sans-serif;font-weight:500;font-size:.875rem;line-height:1.5;text-align:center;cursor:pointer;transition:transform 180ms var(--ease,cubic-bezier(.16,1,.3,1)),background-color 180ms,border-color 180ms}.ds-button:hover:not(:disabled){transform:translateY(-2px)}.ds-button:active:not(:disabled){transform:translateY(0) scale(.98)}.ds-button:focus-visible{outline:3px solid var(--accent,#74293f);outline-offset:4px}.ds-button:disabled{cursor:wait;opacity:.6}@media(prefers-reduced-motion:reduce){.ds-button{transition:none}}.ds-button-primary{background:var(--action,#74293f);color:var(--on-action,#fff8fb);border-color:var(--on-action,#fff8fb)}.ds-button-primary:hover:not(:disabled){background:var(--action-hover,#5f2035)}"
    },
    {
