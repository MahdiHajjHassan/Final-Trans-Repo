      "html": "<nav class=\"ds-nav\" aria-label=\"Main navigation\"><a href=\"#play\" aria-current=\"page\">Play</a><a href=\"#account\">Account</a></nav>",
      "css": ".ds-nav{display:flex;flex-wrap:wrap;align-items:center;gap:.25rem;font-family:\"Readex Pro\",system-ui,sans-serif}.ds-nav a{display:inline-flex;align-items:center;min-height:44px;color:var(--muted,#705963);text-decoration:none;padding:.65rem .9rem;border-radius:.6rem;font-size:.8125rem;transition:color 150ms,background-color 150ms}.ds-nav a:hover,.ds-nav a[aria-current=\"page\"]{background:var(--muted-surface,#efe4e8);color:var(--text,#35242d)}.ds-nav a[aria-current=\"page\"]{font-weight:600}.ds-nav a:focus-visible{outline:3px solid var(--accent,#74293f);outline-offset:4px}@media(prefers-reduced-motion:reduce){.ds-nav a{display:inline-flex;align-items:center;min-height:44px;transition:none}}"
