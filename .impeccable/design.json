    },
    {
      "name": "Club Play Panel",
      "kind": "card",
      "refersTo": "club-panel",
      "description": "The deep-wine enclosure used for the computer play choice.",
      "html": "<section class=\"ds-club-panel\"><h2>Computer</h2><p>Play a game against the computer.</p></section>",
      "css": ".ds-club-panel{display:flex;flex-direction:column;align-items:start;gap:1rem;min-width:0;padding:2rem;background:var(--club,#3e1c2b);color:var(--on-club,#fff4f8);border-radius:1rem;font-family:\"Readex Pro\",system-ui,sans-serif}.ds-club-panel h2{margin:0;font-size:2rem;line-height:1.35;font-weight:600;letter-spacing:-.025em}.ds-club-panel p{margin:0;color:var(--club-muted,#dfbecb);max-width:40ch;font-size:.875rem;line-height:1.7}@media(max-width:760px){.ds-club-panel{padding:1.75rem}}@media(max-width:520px){.ds-club-panel{padding:1.5rem}.ds-club-panel h2{font-size:1.75rem}}"
    },
    {
      "name": "Game Cell",
      "kind": "custom",
      "refersTo": "game-cell",
      "description": "A stable native cell button with an authored SVG X mark.",
      "html": "<button class=\"ds-game-cell\" type=\"button\" aria-disabled=\"true\" aria-label=\"Row 1, column 1: X\"><svg class=\"ds-mark\" viewBox=\"0 0 100 100\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"9\" stroke-linecap=\"round\" aria-hidden=\"true\"><path d=\"M24 24 76 76\"/><path d=\"M76 24 24 76\"/></svg></button>",
      "css": ".ds-game-cell{aspect-ratio:1;width:140px;min-height:60px;border:1px solid var(--control-border,#957483);border-radius:0;background:var(--surface,#fffafb);display:grid;place-items:center;padding:0;transition:background-color 180ms,box-shadow 180ms}.ds-game-cell[aria-disabled=\"true\"]{opacity:1;cursor:default}.ds-game-cell[aria-disabled=\"false\"]:hover{background:var(--muted-surface,#efe4e8);box-shadow:inset 0 0 0 2px var(--accent,#74293f)}.ds-game-cell[aria-disabled=\"false\"]:active{background:var(--muted-surface,#efe4e8)}.ds-game-cell:focus-visible{position:relative;outline:3px solid var(--accent,#74293f);outline-offset:-5px}.ds-mark{width:65%;height:65%;max-height:110px;color:var(--x,#842b4a)}@media(prefers-reduced-motion:reduce){.ds-game-cell{transition:none}}"
    },
    {
      "name": "Error Alert",
      "kind": "custom",
      "refersTo": "alert",
      "description": "Explicit recovery feedback with an alert role.",
      "html": "<div class=\"ds-alert\" role=\"alert\">Connection lost. Refresh to read the saved game.</div>",
      "css": ".ds-alert{border:1px solid var(--error,#ae263f);border-radius:var(--radius,.75rem);background:var(--muted-surface,#efe4e8);color:var(--error,#ae263f);padding:1rem 1.125rem;font-family:\"Readex Pro\",system-ui,sans-serif;font-size:.875rem;line-height:1.7}"
    },
    {
      "name": "Decorative Board",
      "kind": "custom",
      "refersTo": "decorative-board",
      "description": "A tilted finished-board illustration with bold round marks and a muted center tile.",
      "html": "<div class=\"ds-artwork\" aria-hidden=\"true\"><div class=\"ds-artwork-board\" dir=\"ltr\"><span class=\"ds-artwork-cell ds-artwork-x\"><svg viewBox=\"0 0 100 100\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"10\" stroke-linecap=\"round\"><path d=\"m28 28 44 44m0-44L28 72\"/></svg></span><span class=\"ds-artwork-cell ds-artwork-o\"><svg viewBox=\"0 0 100 100\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"10\" stroke-linecap=\"round\"><circle cx=\"50\" cy=\"50\" r=\"28\"/></svg></span><span class=\"ds-artwork-cell\"></span><span class=\"ds-artwork-cell\"></span><span class=\"ds-artwork-cell ds-artwork-x\"><svg viewBox=\"0 0 100 100\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"10\" stroke-linecap=\"round\"><path d=\"m28 28 44 44m0-44L28 72\"/></svg></span><span class=\"ds-artwork-cell ds-artwork-o\"><svg viewBox=\"0 0 100 100\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"10\" stroke-linecap=\"round\"><circle cx=\"50\" cy=\"50\" r=\"28\"/></svg></span><span class=\"ds-artwork-cell ds-artwork-o\"><svg viewBox=\"0 0 100 100\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"10\" stroke-linecap=\"round\"><circle cx=\"50\" cy=\"50\" r=\"28\"/></svg></span><span class=\"ds-artwork-cell\"></span><span class=\"ds-artwork-cell ds-artwork-x\"><svg viewBox=\"0 0 100 100\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"10\" stroke-linecap=\"round\"><path d=\"m28 28 44 44m0-44L28 72\"/></svg></span><svg class=\"ds-artwork-line\" viewBox=\"0 0 300 300\" fill=\"none\"><path d=\"M44 44 256 256\" stroke=\"currentColor\" stroke-width=\"7\" stroke-linecap=\"round\"/></svg></div></div>",
      "css": ".ds-artwork{box-sizing:border-box;background:var(--club,#3e1c2b);border-radius:1.5rem;padding:2.5rem;width:100%;max-width:29rem;aspect-ratio:1;display:grid;place-items:center}.ds-artwork-board{display:grid;grid-template-columns:repeat(3,1fr);position:relative;width:100%;aspect-ratio:1;transform:rotate(-7deg);gap:4px}.ds-artwork-cell{display:grid;place-items:center;background:var(--surface,#fffafb);border-radius:8px}.ds-artwork-cell svg{width:100%;height:100%}.ds-artwork-x{color:var(--x,#842b4a)}.ds-artwork-o{color:var(--o,#605d74)}.ds-artwork-cell:nth-child(5){background:var(--muted-surface,#efe4e8)}.ds-artwork-line{position:absolute;inset:0;width:100%;height:100%;color:var(--text,#35242d);pointer-events:none}@media(max-width:760px){.ds-artwork{padding:1.25rem;border-radius:1rem}}@media(max-width:520px){.ds-artwork{padding:2rem}}"
    }
  ],
  "narrative": {
    "northStar": "The Modern Game Club",
    "overview": "Ivory surfaces and deep wine framing make the game welcoming; burgundy actions and rose accents define both themes. Burgundy X and slate-violet O give the board its own visual language. Flat color, geometric marks and a locally hosted typeface carry the identity across the lobby, live game, forms, tables and legal pages.\n\nExpressive scale belongs to the introduction and the board. Supporting screens use the same controls with quieter type and clear reading order. Authored SVG supplies the game artwork and icons; motion describes confirmed state changes, then stops. The system uses no gradients, remote fonts or decorative loops.",
    "keyCharacteristics": [
      "Ivory surfaces with wine framing and burgundy/rose actions.",
      "One local type family for Latin and Arabic.",
      "Geometric X/O marks with distinct shape and color.",
      "Flat everyday surfaces and deliberate modal depth.",
      "Bounded motion, stable controls and explicit state feedback."
    ],
    "rules": [
      {
        "name": "The Shape Before Color Rule",
        "body": "Keep X/O geometry, text labels and active-state cues alongside color; color alone must never carry the game state.",
        "section": "colors"
      },
      {
        "name": "The Shared Script Rule",
        "body": "Use the same local family for English, French and Arabic; preserve translated labels and natural wrapping rather than forcing uppercase interface copy.",
        "section": "typography"
      },
      {
        "name": "The Logical Flow Rule",
        "body": "Use logical spacing and isolated player names for RTL; keep the physical game board and invitation codes LTR so positions remain consistent across languages.",
        "section": "layout"
      },
      {
        "name": "The Modal Depth Rule",
        "body": "Reserve floating elevation for modal interruption; use tonal surfaces and borders for normal content.",
        "section": "elevation"
      },
      {
        "name": "The Confirmed Motion Rule",
        "body": "Animate committed state without delaying input, retrying uncertain moves, replaying initial marks or replacing focused cell buttons.",
        "section": "components"
      }
    ],
    "dos": [
      "**Do** reuse burgundy/rose semantic colors in both themes and preserve the body-text contrast requirement (4.5:1).",
      "**Do** preserve translated labels, logical layout, LTR board positions and isolated player names.",
      "**Do** retain native controls, visible focus, stable board buttons and explicit connection recovery.",
      "**Do** use short SVG/CSS state motion that finishes and respects reduced motion.",
      "**Do** verify rendered desktop, 360px and narrow 320px reflow, both themes, French and Arabic RTL when changing the interface."
    ],
    "donts": [
      "**Don't** introduce green or orange accents or restore the superseded serif/fine-line styling.",
      "**Don't** add gradients, remote font requests or decorative animation loops.",
      "**Don't** replace game labels or shape cues with color alone.",
      "**Don't** place ordinary content on floating shadows or turn every section into an enclosed card.",
      "**Don't** delay rematch navigation or invent optimistic board state for an animation.",
      "**Don't** infer completed visual or accessibility verification from this source-based design record."
    ]
  }
}
