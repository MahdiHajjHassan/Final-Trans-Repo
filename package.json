{
  "name": "tic-tac-toe",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "prisma generate && next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "prisma generate && next typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "prisma generate && vitest run --maxWorkers=1",
    "test:server": "prisma generate && vitest run --maxWorkers=1",
    "test:e2e": "playwright test --project=chrome --project=brave --project=firefox",
    "db:generate": "prisma generate",
    "db:migrate": "node -- scripts/migrate.mjs",
    "db:seed": "prisma generate && tsx scripts/seed.ts",
    "setup": "node -- scripts/setup.mjs",
    "smoke": "node scripts/smoke.mjs",
    "smoke:auth": "node -- scripts/smoke-auth.mjs",
    "audit:source": "node -- scripts/audit-source.mjs",
    "verify": "node -- scripts/verify.mjs",
    "rehearse": "node -- scripts/rehearse.mjs",
    "smoke:games": "node -- scripts/smoke-games.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.{mjs,ts}\" \"tests/**/*.ts\" \"*.{ts,mjs,json,yaml,yml}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.{mjs,ts}\" \"tests/**/*.ts\" \"*.{ts,mjs,json,yaml,yml}\"",
    "account:email": "tsx scripts/set-account-email.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.2",
    "@prisma/adapter-better-sqlite3": "7.10.1",
    "@prisma/client": "7.10.1",
    "better-sqlite3": "13.0.3",
    "dotenv": "18.0.9",
    "next": "16.4.3",
    "nodemailer": "10.3.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.2",
    "@types/nodemailer": "8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.3",
    "prettier": "3.9.10",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
