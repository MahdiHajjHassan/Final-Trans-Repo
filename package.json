{
  "name": "tic-tac-toe",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.2 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "prisma generate && next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "prisma generate && next typegen && tsc --noEmit",
    "lint": "npm run lint:compat && eslint . --max-warnings 0",
    "test": "prisma generate && vitest run --maxWorkers=1",
    "test:e2e": "playwright test --project=chrome --project=brave --project=firefox",
    "db:generate": "prisma generate",
    "db:migrate": "node -- scripts/db/migrate.mjs",
    "db:seed": "prisma generate && tsx scripts/db/seed.ts",
    "setup": "node -- scripts/setup.mjs",
    "smoke": "node scripts/checks/smoke.mjs",
    "smoke:auth": "node -- scripts/checks/smoke-auth.mjs",
    "audit:source": "node -- scripts/checks/audit-source.mjs",
    "verify": "node -- scripts/checks/verify.mjs",
    "smoke:games": "node -- scripts/checks/smoke-games.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.{mjs,ts}\" \"tests/**/*.ts\" \"*.{ts,mjs,json,yaml,yml}\" \"deploy/*.yaml\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.{mjs,ts}\" \"tests/**/*.ts\" \"*.{ts,mjs,json,yaml,yml}\" \"deploy/*.yaml\"",
    "account:email": "tsx scripts/db/set-account-email.ts",
    "lint:compat": "node scripts/checks/check-lint-compat.mjs"
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.2",
    "@prisma/adapter-better-sqlite3": "7.10.1",
    "@prisma/client": "7.10.1",
    "better-sqlite3": "13.0.3",
    "dotenv": "18.0.9",
    "next": "16.4.3",
    "nodemailer": "10.3.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.2",
    "@types/nodemailer": "8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.3",
    "prettier": "3.9.10",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.5",
    "@eslint/compat": "2.1.1",
    "@tic-tac-toe/minimatch-compat": "file:tooling/tic-tac-toe-minimatch-compat-1.0.2.tgz"
  },
  "overrides": {
    "eslint-plugin-react": {
      "eslint": "$eslint"
    },
    "eslint-plugin-import": {
      "eslint": "$eslint"
    },
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    },
    "minimatch@<11": "$@tic-tac-toe/minimatch-compat"
  },
  "prettier": {
    "printWidth": 100,
    "tabWidth": 2,
    "semi": true,
    "singleQuote": false,
    "trailingComma": "all",
    "endOfLine": "lf"
  }
}
