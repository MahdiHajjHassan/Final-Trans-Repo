generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  MEMBER
  ADMIN
}

// Accounts, their sessions and their games as X or O. Passwords are stored as hashes.
model User {
  id           String    @id @default(uuid())
  email        String    @unique
  displayName  String
  passwordHash String
  role         Role      @default(MEMBER)
  createdAt    DateTime  @default(now())
  sessions     Session[]
  gamesAsX     Game[]    @relation("GameX")
  gamesAsO     Game[]    @relation("GameO")
}

// One login per browser session. Its ID is the token hash, never the raw cookie token.
model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// A fixed-window action counter, keyed by the hash of its scope and client/account.
model RateLimitBucket {
  key         String   @id
  windowStart DateTime
  count       Int      @default(0)

  @@index([windowStart])
}

enum GameMode {
  HUMAN
  AI
}

enum GameStatus {
  WAITING
  ACTIVE
  FINISHED
  CANCELLED
}

// The latest saved board and result. GameMove keeps the sequence that led to it.
model Game {
  id         String     @id @default(uuid())
  mode       GameMode
  xId        String?
  oId        String?
  // Deleting an account clears its seat; the saved game is kept.
  x          User?      @relation("GameX", fields: [xId], references: [id], onDelete: SetNull)
  o          User?      @relation("GameO", fields: [oId], references: [id], onDelete: SetNull)
  // Nine characters in row order: X, O, or a dot for an empty cell.
  board      String     @default(".........")
  turn       String?    @default("X")
  status     GameStatus @default(WAITING)
  winner     String?
  reason     String?
  inviteCode String?    @unique
  // Every game change increases this number; stale actions are rejected against it.
  version    Int        @default(1)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  finishedAt DateTime?
  moves      GameMove[]

  @@index([xId, updatedAt])
  @@index([oId, updatedAt])
}

// One committed move: its cell, mark and position in the game's move order.
model GameMove {
  id        String   @id @default(uuid())
  gameId    String
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  ply       Int
  mark      String
  cell      Int
  createdAt DateTime @default(now())

  // A game cannot save the same move number or play the same cell twice.
  @@unique([gameId, ply])
  @@unique([gameId, cell])
}
