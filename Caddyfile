{
  auto_https disable_redirects
}
https://localhost {
  tls internal
  reverse_proxy app:3000 {
    header_up X-Taskboard-Client-IP {remote_host}
    # Next strips RSC before proxy.ts; preserve the original classification here.
    header_up X-Taskboard-Page-RSC {http.request.header.RSC}
  }
  header {
    X-Content-Type-Options nosniff
    Referrer-Policy strict-origin-when-cross-origin
  }
}
